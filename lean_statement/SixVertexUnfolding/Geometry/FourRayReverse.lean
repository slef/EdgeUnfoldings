import SixVertexUnfolding.Geometry.FourRayFan

/-! Reverse the cyclic order while keeping the first ray fixed. -/

namespace SixVertexUnfolding.FourRayFan

def reverseLabel : Fin 4 → Fin 4 := ![0, 3, 2, 1]

def reverse (fan : FourRayFan) : FourRayFan where
  ray := fun i => fan.ray (reverseLabel i)
  distinct := (fan.distinct).comp (by decide : Function.Injective reverseLabel)
  height := fan.height
  level := fun i => fan.level (reverseLabel i)
  spans := by
    change Submodule.span ℝ (Set.range (fan.ray ∘ reverseLabel)) = ⊤
    rw [Set.range_comp, (by decide : Function.Surjective reverseLabel).range_eq, Set.image_univ]
    exact fan.spans
  side := fun i => fan.side (3 - i)
  side_nonzero := fun i => fan.side_nonzero (3 - i)
  side_left := by
    intro i
    fin_cases i
    exacts [fan.side_right 3, fan.side_right 2, fan.side_right 1, fan.side_right 0]
  side_right := by
    intro i
    fin_cases i
    exacts [fan.side_left 3, fan.side_left 2, fan.side_left 1, fan.side_left 0]
  side_bound := fun i j => fan.side_bound (3 - i) (reverseLabel j)

/-- Four spanning rays cannot all lie in a plane generated by two vectors. -/
theorem not_contained_in_pair_span (fan : FourRayFan) (a b : Space)
    (member : ∀ i, fan.ray i ∈ Submodule.span ℝ ({a, b} : Set Space)) : False := by
  have inclusion : Submodule.span ℝ (Set.range fan.ray) ≤ Submodule.span ℝ ({a, b} : Set Space) := by
    apply Submodule.span_le.mpr
    rintro x ⟨i, rfl⟩
    exact member i
  have full : Submodule.span ℝ ({a, b} : Set Space) = ⊤ := top_unique (fan.spans ▸ inclusion)
  have points : Set.range ![a, b] = ({a, b} : Set Space) := by
    ext x
    simp [Matrix.range_cons, Matrix.range_empty]
    tauto
  have indexed : Submodule.span ℝ (Set.range ![a, b]) = ⊤ := by rw [points]; exact full
  have impossible := finrank_le_of_span_eq_top indexed
  norm_num [Space] at impossible

end SixVertexUnfolding.FourRayFan
