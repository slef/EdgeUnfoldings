import SixVertexUnfolding.Geometry.HingeDeterminant

/-! Two explicit generating rays suffice for the opposite-petal cone comparisons. -/

namespace SixVertexUnfolding

/-- The closed cone of nonnegative combinations of two planar vectors. -/
def twoRayCone (e f : Plane) : Set Plane :=
  {x | ∃ a b : ℝ, 0 ≤ a ∧ 0 ≤ b ∧ x = a • e + b • f}

/-- Its translate at an apex. -/
def translatedCone (p e f : Plane) : Set Plane := {x | x - p ∈ twoRayCone e f}

theorem twoRayCone_convex (e f : Plane) : Convex ℝ (twoRayCone e f) := by
  rintro x ⟨a, b, ha, hb, rfl⟩ y ⟨c, d, hc, hd, rfl⟩ s t hs ht total
  refine ⟨s * a + t * c, s * b + t * d,
    add_nonneg (mul_nonneg hs ha) (mul_nonneg ht hc),
    add_nonneg (mul_nonneg hs hb) (mul_nonneg ht hd), ?_⟩
  module

theorem zero_mem_twoRayCone (e f : Plane) : (0 : Plane) ∈ twoRayCone e f :=
  ⟨0, 0, le_rfl, le_rfl, by simp⟩

/-- Nonparallel generating rays have unique coefficients. -/
theorem twoRay_coefficients_unique (e f : Plane) (independent : det e f ≠ 0)
    (a b c d : ℝ) (equal : a • e + b • f = c • e + d • f) : a = c ∧ b = d := by
  have along_e := congrArg (fun x => det e x) equal
  have along_f := congrArg (fun x => det f x) equal
  simp only [det_add_right, det_smul_right, det_self, mul_zero, zero_add, add_zero] at along_e along_f
  have reverse_ne : det f e ≠ 0 := by rw [det_swap]; exact neg_ne_zero.mpr independent
  have first_product : (a - c) * det f e = 0 := by nlinarith
  have second_product : (b - d) * det e f = 0 := by nlinarith
  exact ⟨sub_eq_zero.mp ((mul_eq_zero.mp first_product).resolve_right reverse_ne),
    sub_eq_zero.mp ((mul_eq_zero.mp second_product).resolve_right independent)⟩

/-- Two cones pointing toward each other cannot meet when the displacement has negative total coefficients. -/
theorem opposed_cones_disjoint_of_sum (p q e f : Plane) (independent : det e f ≠ 0)
    (a b : ℝ) (displacement : q - p = a • e + b • f) (negative_sum : a + b < 0) :
    Disjoint (translatedCone p e f) (translatedCone q (-e) (-f)) := by
  apply Set.disjoint_left.mpr
  rintro x ⟨s, t, hs, ht, left⟩ ⟨u, v, hu, hv, right⟩
  have combination : q - p = (s + u) • e + (t + v) • f := by
    calc
      q - p = (x - p) - (x - q) := by module
      _ = (s + u) • e + (t + v) • f := by rw [left, right]; module
  have coefficients := twoRay_coefficients_unique e f independent a b (s + u) (t + v)
    (displacement.symm.trans combination)
  obtain ⟨first, second⟩ := coefficients
  linarith

/-- This is the strict distance-sum contradiction in the first opposite-petal case. -/
theorem opposed_cones_disjoint_of_lengths (p q e f : Plane) (independent : det e f ≠ 0)
    (s t L R : ℝ) (displacement : q - p = (s - L) • e + (t - R) • f)
    (shorter : s + t < L + R) : Disjoint (translatedCone p e f) (translatedCone q (-e) (-f)) :=
  opposed_cones_disjoint_of_sum p q e f independent (s - L) (t - R) displacement (by linarith)

theorem mem_twoRayCone_iff_dets (e f x : Plane) (positive : 0 < det e f) :
    x ∈ twoRayCone e f ↔ 0 ≤ det e x ∧ 0 ≤ det x f := by
  constructor
  · rintro ⟨a, b, ha, hb, rfl⟩
    constructor
    · rw [det_add_right, det_smul_right, det_smul_right, det_self, mul_zero, zero_add]
      exact mul_nonneg hb positive.le
    · rw [det_add_left, det_smul_left, det_smul_left, det_self, mul_zero, add_zero]
      exact mul_nonneg ha positive.le
  · rintro ⟨left, right⟩
    refine ⟨det x f / det e f, det e x / det e f, div_nonneg right positive.le, div_nonneg left positive.le, ?_⟩
    ext i
    fin_cases i <;> simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    · change x 0 = det x f / det e f * e 0 + det e x / det e f * f 0
      field_simp [positive.ne']
      simp only [det]
      ring
    · change x 1 = det x f / det e f * e 1 + det e x / det e f * f 1
      field_simp [positive.ne']
      simp only [det]
      ring

/-- Every direction in a sector of width below pi belongs to the cone generated by its boundary rays. -/
theorem direction_mem_twoRayCone (α β θ : ℝ) (width_pos : 0 < β - α) (width_small : β - α < Real.pi)
    (lower : α ≤ θ) (upper : θ ≤ β) : direction θ ∈ twoRayCone (direction α) (direction β) := by
  apply (mem_twoRayCone_iff_dets _ _ _ (by rw [direction_det]; exact Real.sin_pos_of_pos_of_lt_pi width_pos width_small)).mpr
  constructor <;> rw [direction_det] <;>
    apply Real.sin_nonneg_of_nonneg_of_le_pi <;> linarith

end SixVertexUnfolding
